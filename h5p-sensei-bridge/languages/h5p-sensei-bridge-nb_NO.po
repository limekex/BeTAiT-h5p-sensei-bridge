#. Plugin Name of the plugin
#: h5p-sensei-bridge.php
msgid "BeTAiT H5P → Sensei Bridge"
msgstr "BeTAiT H5P → Sensei Bridge"

#. Description of the plugin
#: h5p-sensei-bridge.php
msgid "Captures H5P xAPI results for logged-in users and enforces \"pass to complete\" in Sensei LMS. Stores attempts and provides an admin report (MVP)."
msgstr "Registrerer H5P-resultater for innloggede brukere og krever bestått aktivitet før fullføring i Sensei LMS. Lagrer forsøk og viser en administratorrapport."

#. Author of the plugin
#: h5p-sensei-bridge.php
msgid "BeTAiT / Bjørn-Tore"
msgstr "BeTAiT / Bjørn-Tore"

#: includes/class-fkhs-metabox.php:24
msgid "H5P → Sensei Bridge"
msgstr "H5P → Sensei Bridge"

#: includes/class-fkhs-metabox.php:71
msgid "Set thresholds per H5P. Use 0 for no pass requirement (completion-only)."
msgstr "Angi terskel for hver H5P-aktivitet. Bruk 0 for kun å kreve fullføring etter at et forsøk er registrert."

